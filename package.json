{
  "name": "build-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5183 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "demo": "vite --mode demo --port 5184",
    "local:start": "colima start --cpu 4 --memory 6 --disk 40; supabase stop; supabase start",
    "local:stop": "supabase stop && colima stop",
    "build:pages": "tsc -b && vite build --mode pages && cp dist/index.html dist/404.html && touch dist/.nojekyll"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "2.45.4",
    "buffer": "^6.0.3",
    "papaparse": "^5.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@types/node": "22.7.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "playwright": "^1.65.0",
    "supabase": "^2.40.7",
    "typescript": "5.6.3",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
